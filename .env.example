TZ=America/Toronto

# Internal service URLs
COMFY_URL=http://YOUR-COMFYUI-HOST:8188
OLLAMA_URL=http://YOUR-OLLAMA-HOST:11434
OLLAMA_MODEL=qwen2.5:32b

# R2 offline adapter; deployment/SDK installation requires separate approval.
GPU_RUNNER_URL=http://replace-with-approved-runner:8790
GPU_RUNNER_TOKEN=replace_with_private_high_entropy_runner_token
GPU_RUNNER_OLLAMA_TARGET=ollama
GPU_RUNNER_MUSIC_TARGET=music
GPU_RUNNER_WAIT_SECONDS=3600
GPU_RUNNER_CLIENT_STATE=/var/lib/wake-song-gpu-client

# Workflow
WORKFLOW_PATH=/app/workflow/wakeup_api.json
TARGET_SECONDS=135
OLLAMA_TIMEOUT=300
GENRE_PICK_MODE=random

# Storage paths inside container
LATEST_DIR=/latest-wake
ARCHIVE_DIR=/archive-wake
SEED_MP3=/seed/test.mp3
GENRE_PACKS_PATH=/app/genre_packs.json

# Output filenames
LATEST_NAME=wakeup-latest.mp3
NEW_NAME=wakeup-new.mp3
